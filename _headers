# Equivalente ao bloco "headers" do vercel.json (Cloudflare Pages lê este arquivo)
# Obs.: nosniff e Referrer-Policy já são padrão do Pages; repetidos de propósito
# para o comportamento ser idêntico ao da Vercel.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Painel e páginas sensíveis não indexáveis e sem cache (antes: /(admin|redefinir-senha)(.*))
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/redefinir-senha
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/redefinir-senha*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# CSS/JS versionados por ?v= -> cache longo (antes: /(css|js)/.*)
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens (antes: /images/(.*))
/images/*
  Cache-Control: public, max-age=604800
