# Equivalente ao _redirects + _headers para hospedagem Apache/LiteSpeed (Hostinger).
# Cloudflare Pages ignora este arquivo; a Hostinger ignora _redirects/_headers.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # /br/ -> 301 para /br
  RewriteRule ^br/$ /br [R=301,L]
  # /br -> home, sem trocar a URL
  RewriteRule ^br$ /index.html [L]
</IfModule>

# Arquivos que não são do site (caso sejam enviados por engano)
<FilesMatch "(^\.env|\.md$|\.sql$|^vercel\.json$|^lots-photos.*\.json$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Painel e páginas sensíveis: não indexáveis e sem cache
  <FilesMatch "^(admin|redefinir-senha).*\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
    Header set Cache-Control "no-store"
  </FilesMatch>

  # CSS/JS versionados por ?v= -> cache longo; imagens 7 dias
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
